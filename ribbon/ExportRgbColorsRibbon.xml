<?xml version="1.0" encoding="utf-8" ?>
<RibbonItems xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="RibbonDefinitions.xsd">
  <!-- This Drawing ribbon has no Automation tab. Add one, with Export RGB Colors on it. -->
  <TabCollections>
    <TabCollection Name="Mstn.Drawing">
      <TabRef Name="ExportRgbColors.Automation" Priority="130000">
      </TabRef>
    </TabCollection>
    <TabCollection Name="ModelingTabs">
      <TabRef Name="ExportRgbColors.Automation" Priority="130000">
      </TabRef>
    </TabCollection>
    <TabCollection Name="VisualizationTabs">
      <TabRef Name="ExportRgbColors.Automation" Priority="130000">
      </TabRef>
    </TabCollection>
    <TabCollection Name="Mstn.TaskNavigation.Tabs">
      <TabRef Name="ExportRgbColors.Automation" Priority="130000">
      </TabRef>
    </TabCollection>
  </TabCollections>
  <Tabs>
    <Tab Name="ExportRgbColors.Automation" Priority="130">
      <Label>Automation</Label>
      <TabItems>
        <GroupRef Name="ExportRgbColors.Group" Priority="-10000">
        </GroupRef>
      </TabItems>
    </Tab>
  </Tabs>
  <Groups>
    <Group GroupZone="Primary" Name="ExportRgbColors.Group" PanelType="Collapsible" Priority="100">
      <Label>RGB Colors</Label>
      <Icon Type="NamedIcon">
        <NamedIcon>ColorTable</NamedIcon>
      </Icon>
      <GroupItems>
        <ButtonRef Name="ExportRgbColors.Export" Priority="10000">
          <ButtonParams CollapseToSmall="WhenGroupIsSmall" Size="Large">
            <AccessText>ER</AccessText>
            <PopupAccessText>e</PopupAccessText>
          </ButtonParams>
        </ButtonRef>
      </GroupItems>
    </Group>
  </Groups>
  <Buttons>
    <Button Name="ExportRgbColors.Export" Priority="100">
      <Label>Export RGB Colors</Label>
      <Description>Export ColorIndex, RGB, Layer, and Description to CSV</Description>
      <ButtonParams CollapseToSmall="WhenGroupIsSmall" Size="Large">
      </ButtonParams>
      <ButtonData>
        <CommandData Type="UserKeyinCommand">
          <UserKeyinCommand>
            <Keyin>[RgbCsvExport]RGBCSV DIALOG</Keyin>
            <Icon Type="NamedIcon">
              <NamedIcon>ColorTable</NamedIcon>
            </Icon>
          </UserKeyinCommand>
        </CommandData>
      </ButtonData>
    </Button>
  </Buttons>
</RibbonItems>
